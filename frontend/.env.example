# Public Google OAuth client ID for Google Identity Services.
# Create a Web application client in Google Cloud Console and add the
# local Vite origin plus your deployed frontend origin as authorized origins.
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Set both values to use Supabase instead of the local PHP/MySQL API.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_SITE_URL=https://your-public-site-domain

# Optional: verify your site in Google Search Console with the HTML tag method.
VITE_GOOGLE_SITE_VERIFICATION=your-search-console-verification-token

# Server-only weather key. Never use a VITE_ prefix for this value.
OPENWEATHER_API_KEY=
